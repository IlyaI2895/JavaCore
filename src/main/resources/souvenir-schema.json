{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "manufactureID": {
          "type": "integer",
          "minimum": 1
        },
        "surname": {
          "type": "string",
          "minLength": 1
        },"firstName": {
          "type": "string",
          "minLength": 1
        },
        "age": {
          "type": "integer",
          "minimum": 1
        },
        "country": {
          "type": "string",
          "minLength": 2
        }
      },
      "required": ["surname","firstName", "country","age"],
      "additionalProperties": false
    },
    "price": {
      "type":"number" ,
      "format":"double",
      "minimum": 0.20
    },
    "date": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "name",
    "manufacturer",
    "price",
    "date"
  ],
  "additionalProperties": false
}